# 本地开发配置样例。执行 bash scripts/install.sh 会复制成 .env。
#
# 规则：
# 1. 本文件只写占位符，**永远不要写真实凭证**。
# 2. .env 不会被提交（见 .gitignore）。
# 3. 新增环境变量时必须同步更新本文件并写清楚用途，否则别人的环境会缺变量而不自知。
#    环境变量属于公共契约，见 docs/engineering/01-contracts-and-ownership.md 第 2 节。
#
# 变量名的事实源是 backend/src/goalflow/core/config.py 的 Settings（前缀 GOALFLOW_）。
# 两边必须保持一致：那里加了字段就回来补这里，否则别人的环境会缺变量而不自知。
#
# GOALFLOW_ENV=production 时，SESSION_SECRET 与 CREDENTIAL_ENCRYPTION_KEY 必须填真实值：
# 缺失或仍是下面的 change-me 占位值，服务会直接拒绝启动。

# 运行环境：local / test / production
GOALFLOW_ENV=local

# 数据库。SQLite 单文件库，格式 sqlite+pysqlite:///<绝对或相对路径>。
# 留空则由使用方自行校验；文件不得放在 NFS / SMB 等网络文件系统上。
GOALFLOW_DATABASE_URL=

# Celery 与作业队列
GOALFLOW_REDIS_URL=redis://localhost:6379/0

# 服务端会话签名密钥。生成一个随机值，不要复用其他环境的。
GOALFLOW_SESSION_SECRET=change-me-generate-a-random-32-byte-value

# 用户模型凭证的加密密钥。用户的 API Key 加密后入库，
# 见 docs/development/07-model-provider-design.md。
# 这个密钥一旦丢失，已存储的用户凭证无法解密。
GOALFLOW_CREDENTIAL_ENCRYPTION_KEY=change-me-generate-a-random-32-byte-value

# 是否开放自由注册。首版已确认默认开放、不设邀请码，部署者可关闭。
GOALFLOW_ALLOW_REGISTRATION=true

# 日志级别：DEBUG / INFO / WARNING / ERROR
GOALFLOW_LOG_LEVEL=INFO

# 注意：不要在这里配置模型 API Key。
# 模型凭证由每个用户在应用内自行配置并加密存储，不走环境变量。
